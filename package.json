{
	"name": "osh-viewer",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "run-p \"build-only {@}\" --",
		"preview": "vite preview",
		"build-only": "vite build",
		"format": "prettier --write \"**/*.{js,ts,vue,css,scss,md,json}\" --ignore-path .prettierignore",
		"format:check": "prettier --check \"**/*.{js,ts,vue,css,scss,md,json}\" --ignore-path .prettierignore",
		"host": "vite --host",
		"prepare": "husky"
	},
	"dependencies": {
		"@cesium/engine": "latest",
		"@cesium/widgets": "latest",
		"@deck.gl/core": "^9.1.11",
		"@deck.gl/geo-layers": "^9.1.11",
		"@deck.gl/layers": "^9.1.11",
		"@deck.gl/mesh-layers": "^9.1.11",
		"@jamescoyle/vue-icon": "^0.1.2",
		"@loaders.gl/core": "^4.3.3",
		"@loaders.gl/gltf": "^4.3.3",
		"@mdi/font": "^7.4.47",
		"@mdi/js": "^7.4.47",
		"cesium": "latest",
		"chart.js": "^4.4.9",
		"chartjs-adapter-moment": "^1.0.1",
		"leaflet": "^1.9.4",
		"luxon": "^3.7.2",
		"mapbox-gl": "^3.12.0",
		"ol": "^6.2.1",
		"ol-layerswitcher": "^3.8.1",
		"pinia": "^3.0.4",
		"simple-worker-vite": "^0.3.0",
		"vue": "^3.5.24",
		"vue-router": "^4.5.0",
		"vue-toastification": "^2.0.0-rc.5",
		"vuetify": "^3.10.10"
	},
	"devDependencies": {
		"@tsconfig/node22": "^22.0.2",
		"@types/node": "^24.10.0",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vitejs/plugin-vue-jsx": "^5.1.1",
		"@vue/tsconfig": "^0.8.1",
		"npm-run-all2": "^8.0.4",
		"prettier": "3.6.2",
		"typescript": "^5.9.3",
		"vite": "7.2.2",
		"vite-plugin-static-copy": "^3.1.4",
		"vite-plugin-vue-devtools": "^8.0.3",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.6"
	},
	"lint-staged": {
		"**/*.{js,ts,vue,css,scss,md,json}": [
			"prettier --write --ignore-path .prettierignore",
			"git add"
		]
	}
}
